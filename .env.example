# Environment Variables
# Copy this file to .env.local and fill in the values.

# Frontend runtime API base URL.
# Keep this relative so browser requests stay same-origin in direct Vite dev,
# the local gateway on :8090, and ngrok exposing the gateway.
VITE_API_URL=/api

# Enable client-side mocks (skip real API calls)
# Set to "true" to run the app without a running backend.
# Default: false — real API mode is the default.
#
# Mock-only features (always return empty / 501 in real mode):
#   - Template management (/admin/templates)
#   - Outbound email sending
VITE_USE_MOCKS=false
